{
  "name": "taipei-transit-guide",
  "version": "0.1.0",
  "private": true,
  "//engines": "Node 24 because the data scripts and the test suite are .mts and rely on Node executing TypeScript directly. Unflagged from 23.6; on 22 the tests do not run at all.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run conflicts:check && next build && node scripts/postbuild.mjs",
    "start": "next start",
    "fonts": "node scripts/subset-cjk.mjs",
    "palette": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/palette.mts",
    "favicon": "node scripts/make-favicon.mjs",
    "metrics": "node scripts/type-metrics.mjs",
    "weigh": "node scripts/weigh.mjs",
    "wordmark": "node scripts/make-wordmark.mjs",
    "assets": "npm run fonts && npm run favicon && npm run wordmark",
      "tdx": "node scripts/fetch-tdx.mjs",
      "tdx:bus": "node scripts/fetch-bus-tdx.mjs",
      "tdx:bike": "node scripts/fetch-bike-tdx.mjs",
      "bike:index": "node scripts/generate-bike-indexes.mjs",
    "ntpc:bus": "node scripts/fetch-ntpc-bus-route-data.mjs",
    "bus:joins": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/curate-bus-rail-joins.mts",
    "stations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-stations.mts",
    "geometry": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/geometry-report.mts",
    "colours": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-colours.mts",
    "search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/search-index.mts",
    "conflicts": "node scripts/generate-conflicts-index.mjs",
    "conflicts:check": "node scripts/generate-conflicts-index.mjs --check",
    "data": "npm run stations && npm run colours && npm run search",
    "check": "node scripts/check-links.mjs",
    "a11y": "node scripts/a11y-report.mjs",
    "cvd": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cvd-report.mts",
    "geometry:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/geometry-audit.mts",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts",
    "test": "npm run cite && npm run markers && npm run build && npm run test:unit && npm run facts",
    "verify:browser": "node scripts/browser-verify.mjs",
    "adversarial": "node scripts/adversarial.mjs",
    "facts": "node scripts/fact-check.mjs",
    "cite": "node scripts/citations.mjs",
    "claims": "node scripts/claims.mjs",
    "entities": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/entities.mts",
    "determinism": "node scripts/determinism.mjs",
    "verify": "npm run build && npm run markers && npm run check && npm run links && npm run unused && npm run a11y && npm run facts && npm run cite && npm run claims && npm run test:unit && npm run research && npm run geometry:audit && npm run cvd",
    "image": "node scripts/fetch-commons.mjs",
    "archive": "node scripts/archive-sources.mjs",
    "research": "node scripts/research-check.mjs",
    "links": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/links-audit.mjs",
    "nav": "node scripts/nav-check.mjs",
    "unused": "node scripts/unused-audit.mjs",
    "markers": "node scripts/marker-audit.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@expo-google-fonts/noto-sans-tc": "^0.4.3",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.12.1",
    "fontkit": "^2.0.4",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "typescript": "^7.0.2"
  }
}
